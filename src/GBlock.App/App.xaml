<Application x:Class="GBlock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta: preto + verde -->
            <SolidColorBrush x:Key="Fundo" Color="#0A0A0A" />
            <SolidColorBrush x:Key="FundoCartao" Color="#121212" />
            <SolidColorBrush x:Key="FundoCampo" Color="#0D0D0D" />
            <SolidColorBrush x:Key="FundoHover" Color="#1A1A1A" />
            <SolidColorBrush x:Key="Borda" Color="#242424" />
            <SolidColorBrush x:Key="BordaForte" Color="#333333" />
            <SolidColorBrush x:Key="Texto" Color="#F4F4F5" />
            <SolidColorBrush x:Key="TextoSuave" Color="#8B8B92" />
            <SolidColorBrush x:Key="TextoApagado" Color="#5A5A60" />
            <SolidColorBrush x:Key="Destaque" Color="#22C55E" />
            <SolidColorBrush x:Key="DestaqueHover" Color="#4ADE80" />
            <SolidColorBrush x:Key="DestaqueEscuro" Color="#15803D" />
            <SolidColorBrush x:Key="DestaqueFundo" Color="#0C1F13" />
            <SolidColorBrush x:Key="Perigo" Color="#F87171" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style x:Key="Rotulo" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="TituloSecao" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Destaque}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="Cartao" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FundoCartao}" />
                <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Campos de texto -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource FundoCampo}" />
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="BorderBrush" Value="{StaticResource BordaForte}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CaretBrush" Value="{StaticResource Destaque}" />
                <Setter Property="SelectionBrush" Value="{StaticResource Destaque}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Caixa" CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource DestaqueEscuro}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Destaque}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botoes -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource FundoCartao}" />
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="BorderBrush" Value="{StaticResource BordaForte}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource FundoHover}" />
                                    <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Destaque}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource DestaqueFundo}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource Destaque}" />
                <Setter Property="BorderBrush" Value="{StaticResource Destaque}" />
                <Setter Property="Foreground" Value="#051009" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource DestaqueHover}" />
                                    <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource DestaqueHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource DestaqueEscuro}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{StaticResource Perigo}" />
            </Style>

            <!-- Checkbox quadrado verde -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Caixa" Width="18" Height="18" CornerRadius="5"
                                        Background="{StaticResource FundoCampo}"
                                        BorderBrush="{StaticResource BordaForte}" BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Marca" Data="M 3.5,8.5 L 7,12 L 13.5,4.5"
                                          Stroke="#051009" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Destaque}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Caixa" Property="Background" Value="{StaticResource Destaque}" />
                                    <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Destaque}" />
                                    <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chave liga/desliga (CheckBox com cara de toggle) -->
            <Style x:Key="Chave" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Trilho" Width="40" Height="22" CornerRadius="11"
                                        Background="#262626" BorderBrush="{StaticResource BordaForte}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="Bolinha" Width="16" Height="16" Fill="#9A9AA0"
                                             HorizontalAlignment="Left" Margin="2,0,0,0" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Trilho" Property="BorderBrush" Value="{StaticResource Destaque}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Trilho" Property="Background" Value="{StaticResource Destaque}" />
                                    <Setter TargetName="Trilho" Property="BorderBrush" Value="{StaticResource Destaque}" />
                                    <Setter TargetName="Bolinha" Property="Fill" Value="#051009" />
                                    <Setter TargetName="Bolinha" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bolinha" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox escuro -->
            <ControlTemplate x:Key="SetaCombo" TargetType="ToggleButton">
                <Border x:Name="Caixa" CornerRadius="8" Background="{StaticResource FundoCampo}"
                        BorderBrush="{StaticResource BordaForte}" BorderThickness="1">
                    <Path x:Name="Seta" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource TextoSuave}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Destaque}" />
                        <Setter TargetName="Seta" Property="Stroke" Value="{StaticResource Destaque}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Destaque}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Template="{StaticResource SetaCombo}" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Margin="10,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Margin="0,4,0,0" CornerRadius="8" Background="{StaticResource FundoCartao}"
                                            BorderBrush="{StaticResource DestaqueEscuro}" BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Caixa" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Caixa" Property="Background" Value="{StaticResource DestaqueFundo}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Caixa" Property="Background" Value="{StaticResource DestaqueEscuro}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Barra de rolagem fina -->
            <Style x:Key="PolegarRolagem" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Polegar" CornerRadius="4" Background="#2E2E2E" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Polegar" Property="Background" Value="{StaticResource DestaqueEscuro}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Polegar" Property="Background" Value="{StaticResource Destaque}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PolegarRolagem}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="8" />
                        <Setter Property="MinHeight" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PolegarRolagem}" />
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Barra de progresso arredondada -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Background" Value="#1F1F1F" />
                <Setter Property="Foreground" Value="{StaticResource Destaque}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource FundoCartao}" />
                <Setter Property="Foreground" Value="{StaticResource Texto}" />
                <Setter Property="BorderBrush" Value="{StaticResource DestaqueEscuro}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
