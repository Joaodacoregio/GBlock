<Window x:Class="GBlock.App.Views.JanelaRegra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GBlock.App.Base"
        Title="{Binding Titulo}" Height="780" Width="660" MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/gblock.ico"
        Background="{StaticResource Fundo}">

    <Window.Resources>
        <conv:BoolParaVisibilidadeConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Conteudo rolavel: garante que todos os dias (inclusive sabado e domingo) aparecam -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,20,14,0">
            <StackPanel Margin="0,0,6,0">

                <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

                <!-- Jogo / programa -->
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="JOGO / PROGRAMA" Style="{StaticResource TituloSecao}" />

                        <TextBlock Text="Escolha um processo aberto" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ProcessosDisponiveis}"
                                      SelectedItem="{Binding ProcessoSelecionado}"
                                      DisplayMemberPath="Exibicao" />
                            <Button Grid.Column="1" Content="Atualizar" Margin="8,0,0,0"
                                    Command="{Binding AtualizarProcessosCommand}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ou digite o executavel (sem .exe)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NomeProcesso, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nome da regra" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dias da semana -->
                <Border Style="{StaticResource Cartao}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TEMPO LIBERADO POR DIA" Style="{StaticResource TituloSecao}" />
                            <Button Content="Repetir o 1o dia em todos" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Padding="10,4" FontSize="11" Margin="0,-4,0,0"
                                    Command="{Binding AplicarATodosCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Dias}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Borda}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource Chave}"
                                                      Content="{Binding NomeDia}" IsChecked="{Binding Liberado}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        IsEnabled="{Binding Liberado}">
                                                <TextBox Width="56" Padding="4,6" TextAlignment="Center"
                                                         Text="{Binding Horas, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="h" Margin="6,0,12,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextoSuave}" />
                                                <TextBox Width="56" Padding="4,6" TextAlignment="Center"
                                                         Text="{Binding Minutos, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextoSuave}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Resumo}" Margin="16,0,0,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextoSuave}" FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Configuracoes -->
                <Border Style="{StaticResource Cartao}" Margin="0,14,0,20">
                    <StackPanel>
                        <TextBlock Text="CONFIGURACOES" Style="{StaticResource TituloSecao}" />

                        <CheckBox Style="{StaticResource Chave}" Content="Permitir jogar depois do horario"
                                  IsChecked="{Binding PermitirAposHorario}" />

                        <!-- So aparece quando NAO pode jogar depois do horario -->
                        <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                                Background="{StaticResource DestaqueFundo}"
                                BorderBrush="{StaticResource DestaqueEscuro}" BorderThickness="1"
                                Visibility="{Binding PermitirAposHorario,
                                    Converter={StaticResource BoolParaVisibilidade},
                                    ConverterParameter=Invertido}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Horario limite" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Margin="0,0,14,0" />
                                    <TextBox Width="56" Padding="4,6" TextAlignment="Center"
                                             Text="{Binding HorarioHoras, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text=":" FontSize="16" FontWeight="Bold" Margin="6,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Destaque}" />
                                    <TextBox Width="56" Padding="4,6" TextAlignment="Center"
                                             Text="{Binding HorarioMinutos, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ResumoHorario}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{StaticResource DestaqueHover}" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="Avisar quando faltarem" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextoSuave}" />
                            <TextBox Width="56" Padding="4,6" Margin="10,0" TextAlignment="Center"
                                     Text="{Binding MinutosAviso, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="minutos" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextoSuave}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource Chave}" Content="Regra ativa" Margin="0,16,0,0"
                                  IsChecked="{Binding Ativa}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodape fixo -->
        <Border Grid.Row="1" Background="{StaticResource FundoCartao}"
                BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <TextBlock Text="{Binding Erro}" Foreground="{StaticResource Perigo}" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,200,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="Cancelar_Click" />
                    <Button Content="Salvar" Margin="8,0,0,0" Style="{StaticResource BotaoPrimario}"
                            Click="Salvar_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
