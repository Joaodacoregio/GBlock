<Window x:Class="GBlock.App.Views.JanelaRegra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GBlock.App.Base"
        Title="{Binding Titulo}" Height="640" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Fundo}">

    <Window.Resources>
        <conv:BoolParaVisibilidadeConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Processo" Style="{StaticResource Rotulo}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding ProcessosDisponiveis}"
                          SelectedItem="{Binding ProcessoSelecionado}"
                          DisplayMemberPath="Exibicao" />
                <Button Grid.Column="1" Content="Atualizar" Margin="8,0,0,0"
                        Command="{Binding AtualizarProcessosCommand}" />
            </Grid>

            <TextBlock Text="ou digite o nome do executavel (sem .exe)"
                       Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
            <TextBox Text="{Binding NomeProcesso, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Nome da regra" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,8">
            <TextBlock Text="Tempo liberado por dia" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Repetir o 1o dia em todos" Margin="14,0,0,0" Padding="10,4" FontSize="11"
                    Command="{Binding AplicarATodosCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource FundoCartao}" CornerRadius="10"
                BorderBrush="{StaticResource Borda}" BorderThickness="1" Padding="6">
            <ItemsControl ItemsSource="{Binding Dias}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Content="{Binding NomeDia}" IsChecked="{Binding Liberado}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        IsEnabled="{Binding Liberado}">
                                <TextBox Width="46" TextAlignment="Center"
                                         Text="{Binding Horas, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="h" Margin="6,6,10,0" Foreground="{StaticResource TextoSuave}" />
                                <TextBox Width="46" TextAlignment="Center"
                                         Text="{Binding Minutos, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="min" Margin="6,6,0,0" Foreground="{StaticResource TextoSuave}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Resumo}" Margin="16,6,0,0"
                                       Foreground="{StaticResource TextoSuave}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Avisar quando faltarem" VerticalAlignment="Center"
                       Foreground="{StaticResource TextoSuave}" FontSize="12" />
            <TextBox Width="50" Margin="8,0" TextAlignment="Center"
                     Text="{Binding MinutosAviso, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="minutos" VerticalAlignment="Center"
                       Foreground="{StaticResource TextoSuave}" FontSize="12" />
            <CheckBox Content="Regra ativa" Margin="24,0,0,0" IsChecked="{Binding Ativa}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding Erro}" Foreground="#F87171" VerticalAlignment="Center" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancelar_Click" />
                <Button Content="Salvar" Margin="8,0,0,0" Style="{StaticResource BotaoPrimario}"
                        Click="Salvar_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
