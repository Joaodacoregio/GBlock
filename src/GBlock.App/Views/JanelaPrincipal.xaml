<Window x:Class="GBlock.App.Views.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GBlock.App.Base"
        Title="GBlock — controle de tempo" Height="620" Width="880" MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/gblock.ico"
        Background="{StaticResource Fundo}">

    <Window.Resources>
        <conv:BoolParaVisibilidadeConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource DestaqueFundo}"
                    BorderBrush="{StaticResource DestaqueEscuro}" BorderThickness="1">
                <Image Source="/Assets/gblock.ico" Width="36" Height="36"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="26" FontWeight="Bold">
                    <Run Text="G" Foreground="{StaticResource Destaque}" /><Run Text="Block" />
                </TextBlock>
                <TextBlock Text="tempo de tela por processo" Foreground="{StaticResource TextoSuave}" FontSize="12" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Cartao}" Padding="14,10" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="CONFIGURACOES" Style="{StaticResource TituloSecao}" Margin="0,0,0,6" />
                    <CheckBox Style="{StaticResource Chave}" Content="Iniciar com o Windows"
                              ToolTip="Abre direto na bandeja quando o Windows liga"
                              IsChecked="{Binding IniciarComWindows}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lista de regras -->
        <Border Grid.Row="1" Style="{StaticResource Cartao}" Padding="6">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidade}}">
                    <Image Source="/Assets/gblock.ico" Width="56" Height="56" Opacity="0.35" />
                    <TextBlock Text="Nenhuma regra ainda" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Clique em Nova regra para escolher um jogo ou programa."
                               Foreground="{StaticResource TextoSuave}" HorizontalAlignment="Center" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Itens}"
                         SelectedItem="{Binding Selecionado}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="6,5" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Caixa" CornerRadius="10"
                                                Background="{StaticResource FundoCampo}" BorderThickness="1"
                                                BorderBrush="{StaticResource Borda}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Faixa" CornerRadius="10,0,0,10" Background="Transparent" />
                                                <ContentPresenter Grid.Column="1" Margin="14,12,16,12" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource FundoHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource DestaqueEscuro}" />
                                                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource DestaqueFundo}" />
                                                <Setter TargetName="Faixa" Property="Background" Value="{StaticResource Destaque}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="10,0,0,0" CornerRadius="10" Padding="9,2"
                                                Background="{Binding CorStatus}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusTexto}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#051009" />
                                        </Border>
                                        <Border Margin="6,0,0,0" CornerRadius="10" Padding="9,2" VerticalAlignment="Center"
                                                Background="#1F1F1F"
                                                Visibility="{Binding Ativa,
                                                    Converter={StaticResource BoolParaVisibilidade},
                                                    ConverterParameter=Invertido}">
                                            <TextBlock Text="pausada" FontSize="11" Foreground="{StaticResource TextoSuave}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                        <TextBlock Text="{Binding NomeProcesso, StringFormat={}{0}.exe}"
                                                   Foreground="{StaticResource TextoSuave}" FontSize="12" />
                                        <TextBlock FontSize="12" Margin="10,0,0,0" Foreground="{StaticResource Destaque}"
                                                   Visibility="{Binding TemHorarioLimite, Converter={StaticResource BoolParaVisibilidade}}">
                                            <Run Text="{Binding HorarioTexto, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <ProgressBar Minimum="0" Maximum="100"
                                                 Value="{Binding Percentual, Mode=OneWay}"
                                                 Foreground="{Binding CorStatus}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <Run Text="{Binding ConsumidoTexto, Mode=OneWay}" />
                                        <Run Text="/" Foreground="{StaticResource TextoApagado}" />
                                        <Run Text="{Binding LimiteTexto, Mode=OneWay}" Foreground="{StaticResource TextoSuave}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource Destaque}" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Text="{Binding RestanteTexto, StringFormat=restam {0}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Acoes -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="+  Nova regra" Style="{StaticResource BotaoPrimario}"
                        Command="{Binding NovaRegraCommand}" />
                <Button Content="Editar" Margin="8,0,0,0" Command="{Binding EditarRegraCommand}" />
                <Button Content="Zerar tempo de hoje" Margin="8,0,0,0" Command="{Binding ZerarUsoCommand}" />
                <Button Content="Remover" Margin="8,0,0,0" Style="{StaticResource BotaoPerigo}"
                        Command="{Binding RemoverRegraCommand}" />
            </StackPanel>
            <TextBlock Text="Fechar a janela mantem o GBlock na bandeja."
                       Foreground="{StaticResource TextoApagado}" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
