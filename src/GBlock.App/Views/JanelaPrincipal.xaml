<Window x:Class="GBlock.App.Views.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GBlock.App.Base"
        Title="GBlock — controle de tempo" Height="580" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fundo}">

    <Window.Resources>
        <conv:BoolParaVisibilidadeConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="GBlock" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="tempo de tela por processo" Margin="12,10,0,0"
                       Foreground="{StaticResource TextoSuave}" />
        </StackPanel>

        <CheckBox Grid.Row="1" Margin="0,14,0,14"
                  Content="Iniciar junto com o Windows (direto na bandeja)"
                  IsChecked="{Binding IniciarComWindows}" />

        <Border Grid.Row="2" Background="{StaticResource FundoCartao}" CornerRadius="10"
                BorderBrush="{StaticResource Borda}" BorderThickness="1">
            <Grid>
                <TextBlock Text="Nenhuma regra ainda. Clique em Nova regra para escolher um processo."
                           Foreground="{StaticResource TextoSuave}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidade}}" />

                <ListBox ItemsSource="{Binding Itens}"
                         SelectedItem="{Binding Selecionado}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Caixa" CornerRadius="8" Padding="14,12"
                                                Background="#111827" BorderThickness="1"
                                                BorderBrush="{StaticResource Borda}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Caixa" Property="BorderBrush"
                                                        Value="{StaticResource Destaque}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Caixa" Property="Background" Value="#182234" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold" />
                                        <Border Margin="10,2,0,0" CornerRadius="10" Padding="8,2"
                                                Background="{Binding CorStatus}">
                                            <TextBlock Text="{Binding StatusTexto}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="pausada" FontSize="11" Margin="8,4,0,0"
                                                   Foreground="{StaticResource TextoSuave}"
                                                   Visibility="{Binding Ativa,
                                                       Converter={StaticResource BoolParaVisibilidade},
                                                       ConverterParameter=Invertido}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding NomeProcesso, StringFormat={}{0}.exe}"
                                               Foreground="{StaticResource TextoSuave}" FontSize="12"
                                               Margin="0,2,0,8" />

                                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding Percentual, Mode=OneWay}"
                                                 Foreground="{Binding CorStatus}" Background="#243147"
                                                 BorderThickness="0" Width="440" HorizontalAlignment="Left" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock FontSize="18" HorizontalAlignment="Right">
                                        <Run Text="{Binding ConsumidoTexto, Mode=OneWay}" />
                                        <Run Text=" / " Foreground="#6B7280" />
                                        <Run Text="{Binding LimiteTexto, Mode=OneWay}" Foreground="#9CA3AF" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextoSuave}" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Text="{Binding RestanteTexto, StringFormat=restam {0}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Nova regra" Style="{StaticResource BotaoPrimario}"
                    Command="{Binding NovaRegraCommand}" />
            <Button Content="Editar" Margin="8,0,0,0" Command="{Binding EditarRegraCommand}" />
            <Button Content="Remover" Margin="8,0,0,0" Command="{Binding RemoverRegraCommand}" />
            <Button Content="Zerar tempo de hoje" Margin="8,0,0,0" Command="{Binding ZerarUsoCommand}" />
            <TextBlock Text="Fechar a janela mantem o GBlock rodando na bandeja."
                       Foreground="{StaticResource TextoSuave}" FontSize="11"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
