<Window x:Class="GBlock.App.Views.JanelaAviso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GBlock" Height="200" Width="390"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize">

    <Border Background="{StaticResource FundoCartao}" CornerRadius="14"
            BorderBrush="{StaticResource DestaqueEscuro}" BorderThickness="1" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="/Assets/gblock.ico" Width="22" Height="22" VerticalAlignment="Center" />
                <Border x:Name="Marcador" Width="10" Height="10" CornerRadius="5" Margin="10,0,0,0"
                        Background="#F59E0B" VerticalAlignment="Center" />
                <TextBlock x:Name="TituloTexto" Text="GBlock" FontSize="16" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="MensagemTexto" TextWrapping="Wrap" Margin="0,12,0,0"
                       FontSize="13" Foreground="#E4E4E7" />

            <Grid Grid.Row="2">
                <TextBlock x:Name="ContagemTexto" Foreground="{StaticResource TextoSuave}" FontSize="11"
                           VerticalAlignment="Center" />
                <Button Content="Ok" HorizontalAlignment="Right" Padding="20,6"
                        Style="{StaticResource BotaoPrimario}" Click="Fechar_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
