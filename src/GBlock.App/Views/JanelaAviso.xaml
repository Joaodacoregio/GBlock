<Window x:Class="GBlock.App.Views.JanelaAviso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GBlock" Height="190" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize">

    <Border Background="{StaticResource FundoCartao}" CornerRadius="12"
            BorderBrush="{StaticResource Borda}" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border x:Name="Marcador" Width="10" Height="10" CornerRadius="5"
                        Background="#D97706" VerticalAlignment="Center" />
                <TextBlock x:Name="TituloTexto" Text="GBlock" FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="MensagemTexto" TextWrapping="Wrap" Margin="0,12,0,0"
                       FontSize="13" Foreground="#E5E7EB" />

            <Grid Grid.Row="2">
                <TextBlock x:Name="ContagemTexto" Foreground="{StaticResource TextoSuave}" FontSize="11"
                           VerticalAlignment="Center" />
                <Button Content="Ok" HorizontalAlignment="Right" Padding="18,6" Click="Fechar_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
